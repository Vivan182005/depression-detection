+    
+    # 2. Avatar dev (NEW_AUDIO_DAIC/*.wav)
+    avatar_audios = sorted(glob.glob(os.path.join(_REPO_ROOT, 'NEW_AUDIO_DAIC', '*.wav')))
+    for af in avatar_audios:
+        fn = os.path.basename(af)
+        m = re.search(r'(\d+)', fn)
