+    # 3. Sealed cohort (unseen/**/*.wav) strictly label-blind
+    sealed_audios = sorted(glob.glob(os.path.join(_REPO_ROOT, 'unseen', '**', '*.wav'), recursive=True))
+    for af in sealed_audios:
