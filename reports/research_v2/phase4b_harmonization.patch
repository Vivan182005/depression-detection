+            'participant_id': pid,
+            'session_id': str(pid),
+            'domain': 'woz',
+            'is_sealed': False,
+            'audio_path': af,
+            'transcript_path': trans_path,
+            'status': 'pending'
+        })
+        
+    # PID 306 special entry (no audio file on disk)
+    plan.append({
+        'participant_id': 306,
+        'session_id': '306',
+        'domain': 'woz',
+        'is_sealed': False,
