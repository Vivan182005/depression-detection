+    def test_roster_audit_integrity(self):
+        """Verify participant_roster_audit.csv has exact counts and disjoint cohorts."""
+        roster_path = os.path.join(_REPO_ROOT, 'experiments', 'research_v2', 'participant_roster_audit.csv')
